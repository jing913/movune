    "preview": "vite preview"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "dependencies": {
    "@lucide/vue": "^1.34.0",
    "@pinia/colada": "^1.4.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vee-validate/yup": "^4.15.1",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "opencc-js": "1.4.1",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.4",
    "socket.io-client": "4.8.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.39",
    "vue-router": "^5.2.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.1.1",
    "vue-tsc": "^3.3.5"
  }
