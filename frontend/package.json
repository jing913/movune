{
  "name": "movune",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "postbuild": "node scripts/create-pages-fallback.mjs",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,vue,json}\" package.json eslint.config.ts",
